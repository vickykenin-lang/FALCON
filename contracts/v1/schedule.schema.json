{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "falcon://contracts/v1/schedule",
  "title": "FALCON Schedule V1",
  "type": "object",
  "required": ["schedule_id", "objective", "mode", "enabled", "contract_version"],
  "properties": {
    "schedule_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "mode": {"enum": ["ONCE", "RECURRING"]},
    "schedule_expression": {"type": ["string", "null"]},
    "timezone": {"type": "string", "default": "UTC"},
    "enabled": {"type": "boolean"},
    "missed_run_policy": {"enum": ["SKIP", "RUN_ONCE", "CATCH_UP"]},
    "max_concurrent_runs": {"type": "integer", "minimum": 1, "default": 1},
    "contract_version": {"const": "1.0"}
  },
  "additionalProperties": false
}
