{
  "name": "falcon-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "vars": {
    "FALCON_TELEGRAM_ALLOWED_USER_ID": "1311732972"
  },
  "d1_databases": [
    {
      "binding": "FALCON_STATE_DB",
      "database_name": "falcon-state",
      "database_id": "e3f7afa9-b120-4431-9945-1a60edd781a3"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FALCON_TASKS",
        "queue": "falcon-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "falcon-tasks",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5
      }
    ]
  }
}
